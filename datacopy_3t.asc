// Ascend950: pure MTE2 HBM -> UB read bandwidth, no per-tile arithmetic.
#include <algorithm>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <fstream>
#include <iomanip>
#include <sstream>
#include <string>
#include <vector>
#include "acl/acl.h"
#include "kernel_operator.h"

#ifndef TILE_BYTES
#define TILE_BYTES 65536
#endif
#ifndef BUFFER_COUNT
#define BUFFER_COUNT 2
#endif
constexpr uint32_t WORDS = TILE_BYTES / sizeof(uint32_t);
static_assert(BUFFER_COUNT > 0 && TILE_BYTES > 0 && TILE_BYTES % 32 == 0, "Invalid DMA buffer configuration");
constexpr uint32_t SAMPLE_WORDS = 8; // One 32B sample per tile, only in validation.
#define CHECK(x) do { aclError e = (x); if (e != ACL_SUCCESS) { \
    std::fprintf(stderr, "%s failed: %d\n", #x, e); std::exit(1); } } while (0)

__global__ __vector__ void initialize(__gm__ uint32_t* ptr, uint64_t tiles, uint32_t blocks) {
    AscendC::InitSocState();
    AscendC::GlobalTensor<uint32_t> dst;
    dst.SetGlobalBuffer(ptr);
    AscendC::LocalMemAllocator<AscendC::Hardware::UB> alloc;
    auto buf = alloc.Alloc<uint32_t, WORDS>();
    const uint32_t id = AscendC::GetBlockIdx();
    const uint64_t begin = tiles * id / blocks, end = tiles * (id + 1) / blocks;
    for (uint64_t t = begin; t < end; ++t) {
        AscendC::Duplicate(buf, static_cast<uint32_t>(t + 1), WORDS);
        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::DataCopy(dst[t * WORDS], buf, WORDS);
        AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
    }
    AscendC::PipeBarrier<PIPE_ALL>();
}

template <bool BYPASS, bool VERIFY>
__global__ __vector__ void read_hbm(__gm__ uint32_t* ptr, __gm__ uint32_t* sink_ptr,
                                   __gm__ uint64_t* cycles_ptr, uint64_t tiles, uint32_t blocks) {
    AscendC::InitSocState();
    AscendC::GlobalTensor<uint32_t> input, sink;
    AscendC::GlobalTensor<uint64_t> cycles;
    input.SetGlobalBuffer(ptr); sink.SetGlobalBuffer(sink_ptr); cycles.SetGlobalBuffer(cycles_ptr);
    AscendC::LocalMemAllocator<AscendC::Hardware::UB> alloc;
    auto buffers = alloc.Alloc<uint32_t, WORDS * BUFFER_COUNT>();
    auto clock_out = alloc.Alloc<uint64_t, 4>();
    const uint32_t id = AscendC::GetBlockIdx();
    const uint64_t begin = tiles * id / blocks, end = tiles * (id + 1) / blocks;
    AscendC::PipeBarrier<PIPE_ALL>();
    const uint64_t start = AscendC::GetSystemCycle();
    AscendC::SetFlag<AscendC::HardEvent::S_MTE2>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::S_MTE2>(EVENT_ID0);
    for (uint64_t t = begin; t < end; t += BUFFER_COUNT) {
        // Apply the hint to the actual slice; do not rely on operator[] propagating it.
        for (uint32_t slot = 0; slot < BUFFER_COUNT; ++slot) {
            if (t + slot < end) {
                auto src = input[(t + slot) * WORDS];
                src.SetL2CacheHint(BYPASS ? AscendC::CacheMode::CACHE_MODE_DISABLE
                                        : AscendC::CacheMode::CACHE_MODE_NORMAL);
                AscendC::DataCopy(buffers[slot * WORDS], src, WORDS);
            }
        }
        // All batch writes must finish before these UB addresses are reused.
        AscendC::PipeBarrier<PIPE_MTE2>();
        if constexpr (VERIFY) {
            AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE3>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE3>(EVENT_ID0);
            for (uint32_t slot = 0; slot < BUFFER_COUNT; ++slot)
                if (t + slot < end) AscendC::DataCopy(sink[(t + slot) * SAMPLE_WORDS], buffers[slot * WORDS], SAMPLE_WORDS);
            AscendC::SetFlag<AscendC::HardEvent::MTE3_MTE2>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::MTE3_MTE2>(EVENT_ID0);
        }
    }
    // Scalar timestamps must wait for MTE2, not merely MTE2's own pipeline barrier.
    AscendC::SetFlag<AscendC::HardEvent::MTE2_S>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_S>(EVENT_ID0);
    const uint64_t elapsed = AscendC::GetSystemCycle() - start;
    clock_out.SetValue(0, elapsed);
    clock_out.SetValue(1, 0); clock_out.SetValue(2, 0); clock_out.SetValue(3, 0);
    AscendC::SetFlag<AscendC::HardEvent::S_MTE3>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::S_MTE3>(EVENT_ID0);
    AscendC::DataCopy(cycles[id * 4], clock_out, 4);
    if constexpr (!VERIFY) {
        // A tiny observable sink, independent of working-set size.
        for (uint32_t slot = 0; slot < BUFFER_COUNT; ++slot)
            AscendC::DataCopy(sink[(id * BUFFER_COUNT + slot) * SAMPLE_WORDS], buffers[slot * WORDS], SAMPLE_WORDS);
    }
    AscendC::PipeBarrier<PIPE_ALL>();
}

void launch(bool bypass, bool verify, uint32_t blocks, aclrtStream stream,
            uint32_t* input, uint32_t* sink, uint64_t* cycles, uint64_t tiles) {
    if (bypass) {
        if (verify) read_hbm<true, true><<<blocks, 0, stream>>>(input, sink, cycles, tiles, blocks);
        else read_hbm<true, false><<<blocks, 0, stream>>>(input, sink, cycles, tiles, blocks);
    } else {
        if (verify) read_hbm<false, true><<<blocks, 0, stream>>>(input, sink, cycles, tiles, blocks);
        else read_hbm<false, false><<<blocks, 0, stream>>>(input, sink, cycles, tiles, blocks);
    }
}

std::vector<uint32_t> parse_blocks(const std::string& s) {
    std::vector<uint32_t> out;
    std::stringstream ss(s); std::string item;
    while (std::getline(ss, item, ',')) out.push_back(std::stoul(item));
    return out;
}

int main(int argc, char** argv) {
    int device = 0, warmup = 5, repeats = 20;
    uint64_t mib = 4096;
    bool bypass = true;
    std::string block_list = "1,2,4,8,12,16,24,32,40,48,56,64", prefix = "hbm_read";
    for (int i = 1; i < argc; ++i) {
        const std::string arg = argv[i];
        if (arg == "--help") {
            std::puts("--device 0 --mib 4096 --aivs 1,2,4,8,...,64 --cache bypass|normal --warmup 5 --repeats 20 --output PREFIX");
            return 0;
        }
        if (++i >= argc) { std::fprintf(stderr, "Missing value for %s\n", arg.c_str()); return 1; }
        const std::string val = argv[i];
        if (arg == "--device") device = std::stoi(val);
        else if (arg == "--mib") mib = std::stoull(val);
        else if (arg == "--aivs") block_list = val;
        else if (arg == "--cache") {
            if (val != "bypass" && val != "normal") return 1;
            bypass = val == "bypass";
        } else if (arg == "--warmup") warmup = std::stoi(val);
        else if (arg == "--repeats") repeats = std::stoi(val);
        else if (arg == "--output") prefix = val;
        else { std::fprintf(stderr, "Unknown argument %s\n", arg.c_str()); return 1; }
    }
    if (!mib || warmup < 0 || repeats < 1 || mib > 32768) return 1;
    const uint64_t bytes = mib * 1024ULL * 1024ULL, tiles = bytes / TILE_BYTES;
    if (bytes % TILE_BYTES) return 1;
    const auto blocks_list = parse_blocks(block_list);
    CHECK(aclInit(nullptr)); CHECK(aclrtSetDevice(device));
    int64_t available_aiv = 0, l2_bytes = 0, ub_bytes = 0;
    CHECK(aclrtGetDeviceInfo(device, ACL_DEV_ATTR_VECTOR_CORE_NUM, &available_aiv));
    CHECK(aclrtGetDeviceInfo(device, ACL_DEV_ATTR_L2_CACHE_SIZE, &l2_bytes));
    CHECK(aclrtGetDeviceInfo(device, ACL_DEV_ATTR_UBUF_PER_VECTOR_CORE, &ub_bytes));
    if (uint64_t(BUFFER_COUNT) * TILE_BYTES + 32 > static_cast<uint64_t>(ub_bytes)) return 1;
    for (auto n : blocks_list) if (!n || n > available_aiv || tiles / n < BUFFER_COUNT) return 1;
    std::printf("device=%d soc=%s aiv=%lld L2_bytes=%lld UB_bytes=%lld working_set=%llu tile=%u buffers=%u cache=%s\n",
        device, aclrtGetSocName(), (long long)available_aiv, (long long)l2_bytes, (long long)ub_bytes,
        (unsigned long long)bytes, TILE_BYTES, BUFFER_COUNT, bypass ? "bypass" : "normal");
    std::ofstream meta(prefix + ".meta.txt");
    meta << "soc=" << aclrtGetSocName() << "\ndevice=" << device << "\navailable_aiv=" << available_aiv
         << "\nl2_bytes=" << l2_bytes << "\nub_bytes=" << ub_bytes << "\nworking_set_bytes=" << bytes
         << "\ntile_bytes=" << TILE_BYTES << "\nbuffer_count=" << BUFFER_COUNT << "\ncache=" << (bypass ? "bypass" : "normal")
         << "\nwarmup=" << warmup << "\nrepeats=" << repeats << "\n";
    std::ofstream summary(prefix + ".csv"), raw(prefix + ".samples.csv");
    if (!meta || !summary || !raw) return 1;
    summary << "aivs,working_set_bytes,tile_bytes,buffer_count,cache,median_ms,min_ms,p90_ms,median_GBps,best_GBps,median_GiBps,validation\n";
    raw << "aivs,iteration,event_ms,GBps,min_core_cycles,max_core_cycles\n";
    summary << std::setprecision(10); raw << std::setprecision(10);
    aclrtStream stream; aclrtEvent start, stop;
    CHECK(aclrtCreateStream(&stream));
    CHECK(aclrtCreateEventWithFlag(&start, ACL_EVENT_TIME_LINE));
    CHECK(aclrtCreateEventWithFlag(&stop, ACL_EVENT_TIME_LINE));
    uint32_t *input = nullptr, *sink = nullptr;
    uint64_t* cycles = nullptr;
    const uint64_t sink_bytes = std::max(tiles * 32, uint64_t(available_aiv) * BUFFER_COUNT * 32);
    CHECK(aclrtMalloc((void**)&input, bytes, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK(aclrtMalloc((void**)&sink, sink_bytes, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK(aclrtMalloc((void**)&cycles, available_aiv * 32, ACL_MEM_MALLOC_HUGE_FIRST));
    initialize<<<static_cast<uint32_t>(available_aiv), 0, stream>>>(input, tiles, available_aiv);
    CHECK(aclrtSynchronizeStream(stream));
    std::vector<uint32_t> tile_samples(tiles * SAMPLE_WORDS);
    std::vector<uint64_t> core_cycles(available_aiv * 4);
    for (auto n : blocks_list) {
        CHECK(aclrtMemset(sink, sink_bytes, 0, sink_bytes));
        launch(bypass, true, n, stream, input, sink, cycles, tiles);
        CHECK(aclrtSynchronizeStream(stream));
        CHECK(aclrtMemcpy(tile_samples.data(), tile_samples.size() * sizeof(uint32_t), sink, tiles * 32, ACL_MEMCPY_DEVICE_TO_HOST));
        for (uint64_t t = 0; t < tiles; ++t) for (uint32_t j = 0; j < SAMPLE_WORDS; ++j) {
            if (tile_samples[t * SAMPLE_WORDS + j] != t + 1) {
                std::fprintf(stderr, "VERIFY FAIL aivs=%u tile=%llu word=%u got=%u expected=%llu\n", n,
                    (unsigned long long)t, j, tile_samples[t * SAMPLE_WORDS + j], (unsigned long long)(t + 1));
                return 2;
            }
        }
        for (int w = 0; w < warmup; ++w) launch(bypass, false, n, stream, input, sink, cycles, tiles);
        CHECK(aclrtSynchronizeStream(stream));
        std::vector<double> times;
        for (int r = 0; r < repeats; ++r) {
            CHECK(aclrtRecordEvent(start, stream));
            launch(bypass, false, n, stream, input, sink, cycles, tiles);
            CHECK(aclrtRecordEvent(stop, stream)); CHECK(aclrtSynchronizeStream(stream));
            float ms = 0; CHECK(aclrtEventElapsedTime(&ms, start, stop));
            if (!(ms > 0)) return 3;
            CHECK(aclrtMemcpy(core_cycles.data(), n * 32, cycles, n * 32, ACL_MEMCPY_DEVICE_TO_HOST));
            uint64_t lo = UINT64_MAX, hi = 0;
            for (uint32_t k = 0; k < n; ++k) {
                lo = std::min(lo, core_cycles[k * 4]); hi = std::max(hi, core_cycles[k * 4]);
            }
            times.push_back(ms);
            raw << n << ',' << r << ',' << ms << ',' << bytes / (ms * 1e6) << ',' << lo << ',' << hi << '\n';
        }
        std::vector<uint32_t> last_samples(n * SAMPLE_WORDS * BUFFER_COUNT);
        CHECK(aclrtMemcpy(last_samples.data(), last_samples.size() * 4, sink, last_samples.size() * 4, ACL_MEMCPY_DEVICE_TO_HOST));
        for (uint32_t k = 0; k < n; ++k) {
            const uint64_t begin = tiles * k / n, end = tiles * (k + 1) / n;
            for (uint32_t slot = 0; slot < BUFFER_COUNT; ++slot) {
                const uint64_t last = begin + slot + ((end - begin - 1 - slot) / BUFFER_COUNT) * BUFFER_COUNT;
                for (uint32_t j = 0; j < SAMPLE_WORDS; ++j)
                    if (last_samples[(k * BUFFER_COUNT + slot) * SAMPLE_WORDS + j] != last + 1) return 4;
            }
        }
        std::sort(times.begin(), times.end());
        const double median = (times[(repeats - 1) / 2] + times[repeats / 2]) * .5;
        const double p90 = times[static_cast<size_t>((repeats - 1) * .9)];
        summary << n << ',' << bytes << ',' << TILE_BYTES << ',' << BUFFER_COUNT << ',' << (bypass ? "bypass" : "normal") << ','
                << median << ',' << times[0] << ',' << p90 << ',' << bytes / (median * 1e6) << ','
                << bytes / (times[0] * 1e6) << ',' << (double(bytes) / (1ULL << 30)) / (median * 1e-3) << ",PASS\n";
        summary.flush(); raw.flush();
        std::printf("aivs=%2u median=%9.4f ms read=%9.2f GB/s best=%9.2f GB/s validation=PASS\n",
                    n, median, bytes / (median * 1e6), bytes / (times[0] * 1e6)); std::fflush(stdout);
    }
    CHECK(aclrtFree(input)); CHECK(aclrtFree(sink)); CHECK(aclrtFree(cycles));
    CHECK(aclrtDestroyEvent(start)); CHECK(aclrtDestroyEvent(stop)); CHECK(aclrtDestroyStream(stream));
    CHECK(aclrtResetDevice(device)); CHECK(aclFinalize());
    return 0;
}
